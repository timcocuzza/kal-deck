{
  "name": "deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "postbuild": "node scripts/brand_desktop.cjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:install-runtime": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "description": "Deck — your personal NFL research desktop app",
  "author": "Wells Tech Advisors LLC",
  "main": "desktop/main.cjs",
  "desktopName": "com.getwellsedge.deck.desktop",
  "deckSourceProtocol": 1
}
